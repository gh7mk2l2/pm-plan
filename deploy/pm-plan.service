[Unit]
Description=PM-Plan Token Plan service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/data/pmplan
EnvironmentFile=/data/pmplan/.env
ExecStart=/data/pmplan/bin/pm-plan
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/data/pmplan

[Install]
WantedBy=multi-user.target
