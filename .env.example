BIND=127.0.0.1:8080
BASE_URL=https://plan.pmcat.top
DATABASE_URL=postgres://user:password@localhost:5432/dbname
LINUXDO_CLIENT_ID=YOUR_LINUXDO_CLIENT_ID
LINUXDO_CLIENT_SECRET=YOUR_LINUXDO_CLIENT_SECRET
LINUXDO_AUTH_ENDPOINT=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUXDO_USERINFO_ENDPOINT=https://connect.linux.do/api/user
# openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
COOKIE_SECURE=true
WEB_DIR=/data/pmplan/web
APP_TIMEZONE_OFFSET=+08:00
RUST_LOG=pm_plan=info,tower_http=warn,sqlx=warn
# IP 防刷：单 IP 每秒请求上限（0 关闭自动封禁），白名单逗号分隔
IP_FLOOD_PER_SEC=30
IP_GUARD_ALLOW=
